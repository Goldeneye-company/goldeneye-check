# Copy this file to .env and change the values if needed.
# Passwords and keys are NOT kept here: scripts/init-secrets.ps1 (.sh) creates them in secrets/.

# Name or IP users open the portal by (the certificate is issued for it)
SITE_ADDRESS=localhost
# Portal address for recipient links: https:// + SITE_ADDRESS
APP_BASE_URL=https://localhost
APP_TIMEZONE=Asia/Almaty

# Certificate: auto (Let's Encrypt / localhost), internal (Caddy internal CA), files (your own from ./certs)
TLS_MODE=auto
# IP of the server interface the ports are published on (0.0.0.0 - all interfaces)
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Addresses of an external proxy allowed to pass the client IP (leave as is if there is none)
TRUSTED_PROXIES=127.0.0.1/32

DB_NAME=ghalam
DB_SUPERUSER=ghalam_admin
APP_DB_USER=ghalam_app

# Antivirus: with CLAMAV_REQUIRED=true uploads are rejected while ClamAV is unavailable
CLAMAV_ENABLED=true
CLAMAV_REQUIRED=true

# Quota per employee and retention periods
STORAGE_QUOTA_MB=2048
DOCUMENT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
IP_RETENTION_DAYS=90

# Backups (folder on the server)
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
